{#- Lives at body level, NOT inside .cd-header.
    .cd-header sets backdrop-filter, which makes it the containing block for
    position:fixed descendants — nesting this inside it clipped the overlay to
    the header's own height, so the "fullscreen" menu only painted a strip
    and the page showed through. Keep this a sibling of .cd-page. #}
{%- set onBlog = page.url and page.url.startsWith("/blog/") %}
<div class="cd-mobile-nav" id="mobileNav">
  <div class="cd-mobile-nav-top">
    <span class="cd-mobile-nav-title">{{ site.brand.name }}</span>
    <button type="button" class="cd-mobile-close" id="navClose" aria-label="Закрити меню">
      <svg width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true">
        <path d="M1 1L15 15M15 1L1 15" stroke="#fff" stroke-width="1.6" stroke-linecap="round"/>
      </svg>
    </button>
  </div>
  <nav>
    {%- for item in site.nav %}
    <a href="{{ item.href }}" data-nav-close{% if onBlog and item.href == "/blog/" %} class="is-active" aria-current="page"{% endif %}>
      <span class="cd-mobile-nav-num">{{ "0" if loop.index < 10 }}{{ loop.index }}</span> {{ item.label }}
    </a>
    {%- endfor %}
  </nav>
  <a href="{{ site.headerCta.href }}" class="cd-btn cd-btn--orange cd-btn--block" data-nav-close>{{ site.headerCta.label }}</a>
</div>
