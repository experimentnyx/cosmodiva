{#- "Let's train" — the last word takes the accent colour. #}
{%- set bigWords = site.footer.big.split(" ") %}
<footer class="cd-footer">
  <div class="cd-footer-top">
    <nav class="cd-footer-nav">
      {%- for item in site.footer.nav %}
      <a href="{{ item.href }}">{{ item.label }}</a>
      {%- endfor %}
    </nav>
    <div class="cd-footer-social">
      {%- for s in site.footer.social %}
      {#- External links open in a new tab so the site is not lost; the guard
          keeps it off placeholder hrefs like "#", which would open a blank tab. #}
      <a href="{{ s.href }}"{% if s.href.startsWith("http") %} target="_blank" rel="noopener noreferrer"{% endif %}>{{ s.label }}</a>
      {%- endfor %}
    </div>
  </div>

  <p class="cd-footer-big" aria-label="{{ site.footer.big }}">
    {%- for w in bigWords %}{% if loop.last %}<span>{{ w }}</span>{% else %}{{ w }} {% endif %}{% endfor -%}
  </p>

  <div class="cd-footer-legal">
    <span>{{ site.footer.copyright }}</span>
    <span>{{ site.footer.legal }}</span>
  </div>
</footer>
