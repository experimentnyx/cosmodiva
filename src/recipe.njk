---
pagination:
  data: recipes
  size: 1
  alias: recipe
permalink: "/blog/{{ recipe.slug }}/index.html"
layout: layouts/base.njk
eleventyComputed:
  title: "{{ recipe.name }} — рецепт | Anastasiia"
  description: "{{ recipe.name }}: {{ recipe.calories }} ккал, {{ recipe.protein }} г білка. Рецепт із колекції Анастасії Шерстюк."
---
{% import "partials/macros.njk" as ui %}
{% set t = site.blog.post %}

<article class="cd-post">
  <header class="cd-page-intro cd-page-intro--post cd-reveal">
    <p class="cd-crumbs">
      <a href="/blog/">{{ t.back }}</a>
      {%- if recipe.categoryName %}<span class="cd-crumbs-sep">/</span><span class="cd-accent">{{ recipe.categoryName }}</span>{% endif %}
    </p>
    <h1 class="cd-post-title">{{ recipe.name }}</h1>
  </header>

  <div class="cd-post-body">
    <div class="cd-post-photo">
      <img src="{{ recipe.image }}" alt="{{ recipe.name }}" width="400" height="533">
      {%- if recipe.calories %}<span class="cd-pill">{{ recipe.calories }} ккал</span>{% endif %}
    </div>

    <div class="cd-post-main">
      <dl class="cd-macros cd-frame">
        {%- if recipe.minutes %}<div><dt>{{ t.prep }}</dt><dd>{{ recipe.minutes }}<span>хв</span></dd></div>{% endif %}
        {%- if recipe.protein %}<div><dt>{{ t.protein }}</dt><dd>{{ recipe.protein }}<span>г</span></dd></div>{% endif %}
        {%- if recipe.fats %}<div><dt>{{ t.fats }}</dt><dd>{{ recipe.fats }}<span>г</span></dd></div>{% endif %}
        {%- if recipe.carbs %}<div><dt>{{ t.carbs }}</dt><dd>{{ recipe.carbs }}<span>г</span></dd></div>{% endif %}
      </dl>

      {%- if recipe.ingredients %}
      <section class="cd-post-section">
        {{ ui.rail("01", t.ingredients) }}
        {#- Each <li> becomes a tappable checklist row (site.js) — handy while cooking. #}
        <div class="cd-ingredients" data-ingredients>{{ recipe.ingredients | cleanRichText | safe }}</div>
      </section>
      {%- endif %}

      {%- if recipe.instructions %}
      <section class="cd-post-section">
        {{ ui.rail("02", t.instructions, (recipe.minutes ~ " хв") if recipe.minutes else "") }}
        <div class="cd-steps">{{ recipe.instructions | cleanRichText | safe }}</div>
      </section>
      {%- endif %}
    </div>
  </div>

  {%- set others = recipes | reject("slug", recipe.slug) | limit(3) %}
  {%- if others | length %}
  <section class="cd-section cd-section--flush cd-section--tight cd-reveal">
    {{ ui.rail("03", t.more, t.moreLink, "/blog/") }}
    <div class="cd-rcard-grid">
      {%- for r in others %}
      {{ ui.recipeCard(r) }}
      {%- endfor %}
    </div>
  </section>
  {%- endif %}
</article>

{% include "partials/footer.njk" %}
