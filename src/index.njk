---
layout: layouts/base.njk
permalink: /index.html
bodyClass: is-home
---
{% import "partials/macros.njk" as ui %}

<!-- ============ HERO ============ -->
<section class="cd-hero">
  <div class="cd-hero-photo">
    {#- Studio shot from the v2 FigCraft file. The @2x is the full source
        (853px wide) — there is no larger original. #}
    <img src="/assets/hero-photo-studio.webp"
         srcset="/assets/hero-photo-studio.webp 1x, /assets/hero-photo-studio@2x.webp 2x"
         alt="" width="700" height="1050" fetchpriority="high">
  </div>

  <div class="cd-hero-body">
    <p class="cd-crumbs">
      <span class="cd-accent">{{ site.hero.eyebrow }}</span><span class="cd-crumbs-sep">/</span><span>{{ site.hero.eyebrowName }}</span>
    </p>
    <h1 class="cd-hero-title">
      {%- for line in site.hero.titleLines %}
      {#- Last word takes the accent colour. #}
      {% if loop.last %}<span class="cd-accent">{{ line }}</span>{% else %}{{ line }}{% endif %}
      {%- endfor %}
    </h1>
    <div class="cd-hero-foot">
      <p class="cd-hero-desc">{{ site.hero.desc }}</p>
      <div class="cd-btn-row">
        <a href="{{ site.hero.cta.href }}" class="cd-btn cd-btn--orange">{{ site.hero.cta.label }}</a>
        <a href="{{ site.hero.secondaryCta.href }}" class="cd-btn cd-btn--ghost">{{ site.hero.secondaryCta.label }}</a>
      </div>
      <p class="cd-hero-rating">
        <span class="cd-stars" aria-hidden="true">★★★★★</span>
        <b>{{ site.reviews.rating }}</b>
        <span class="cd-muted">{{ site.reviews.ratingSuffix }}</span>
      </p>
    </div>
  </div>
</section>

<!-- ============ STATS ============ -->
<div class="cd-stats-wrap cd-reveal">
  <div class="cd-stats cd-frame">
    {%- for s in site.training.stats %}
    {%- set plus = "+" in s.value %}
    <div class="cd-stat">
      <span class="cd-stat-value"><span class="cd-stat-num">{{ s.value | replace("+", "") }}</span>{% if plus %}<span class="cd-accent">+</span>{% endif %}</span>
      <span class="cd-stat-label">{{ s.label }}</span>
    </div>
    {%- endfor %}
  </div>
</div>

<!-- ============ 01 ABOUT ============ -->
<section id="about" class="cd-section cd-section--glow-left cd-reveal">
  {{ ui.rail("01", site.about.eyebrow, site.about.rail) }}
  <div class="cd-about">
    <figure class="cd-about-photo">
      <img src="{{ site.about.image }}"
           srcset="{{ site.about.image }} 1x, {{ site.about.image | retina }} 2x"
           alt="{{ site.about.imageAlt }}" width="656" height="767" loading="lazy">
      <figcaption>{{ site.about.caption }}</figcaption>
    </figure>
    <div class="cd-about-text">
      <h2 class="cd-h2 cd-h2--about">{{ site.about.heading }}</h2>
      {%- for para in site.about.body %}
      <p class="cd-body">{{ para }}</p>
      {%- endfor %}
      <a href="{{ site.about.cta.href }}" class="cd-btn cd-btn--orange">{{ site.about.cta.label }}</a>
    </div>
  </div>
</section>

<!-- ============ 02 TRAINING ============ -->
<section id="training" class="cd-section cd-section--flush cd-reveal">
  {{ ui.rail("02", site.training.eyebrow, site.training.rail) }}
  <div class="cd-split">
    <h2 class="cd-h2">{{ ui.accent(site.training.heading, site.training.headingAccent) }}</h2>
    <p class="cd-body">{{ site.training.desc }}</p>
  </div>
  <div class="cd-train-photos">
    {%- for p in site.training.photos %}
    <div class="cd-train-photo">
      <img src="{{ p.src }}"
           srcset="{{ p.src }} 1x, {{ p.src | retina }} 2x"
           alt="{{ p.alt }}" width="294" height="434" loading="lazy">
    </div>
    {%- endfor %}
  </div>
  <ol class="cd-process cd-frame">
    {%- for step in site.training.process %}
    <li class="cd-process-step">
      {{ ui.strip(site.training.processLabel, "0" ~ loop.index ~ " / 0" ~ loop.length) }}
      <div class="cd-cell">
        <h3 class="cd-process-title">{{ step.title }}</h3>
        <p class="cd-process-text">{{ step.text }}</p>
      </div>
    </li>
    {%- endfor %}
  </ol>
</section>

<!-- ============ 03 PRICING ============ -->
<section id="pricing" class="cd-section cd-section--glow-center cd-reveal">
  {{ ui.rail("03", site.pricing.eyebrow, site.pricing.rail) }}
  <h2 class="cd-h2 cd-h2--wide">{{ site.pricing.heading }}</h2>
  {#- One framed table: plans sit edge to edge, divided by hairlines (the 1px
      grid gap showing the frame colour through). Each plan is a subgrid
      spanning five shared rows, so header strips, names, prices, buttons and
      feature lists line up across columns however long each one runs. #}
  <div class="cd-plans cd-frame">
    {%- for plan in site.pricing.plans %}
    {#- "2100 ГРН" / "599 ГРН/МІС" → big figure + muted unit. #}
    {%- set priceParts = plan.price.split(" ") %}
    <article class="cd-plan{% if plan.featured %} is-featured{% endif %}">
      {{ ui.strip(plan.label, "0" ~ loop.index, ('<span aria-hidden="true">★ </span>' ~ plan.label) if plan.featured) }}
      <h3 class="cd-plan-name">{{ plan.name }}</h3>
      <p class="cd-plan-price">
        <span class="cd-plan-figure">{{ priceParts[0] }}</span>
        <span class="cd-plan-unit">{{ priceParts | after(1) | join(" ") }}</span>
      </p>
      <div class="cd-plan-cta">
        <button type="button" class="cd-btn cd-btn--{{ 'orange' if plan.featured else 'ghost' }} cd-btn--block"
                data-checkout data-plan="{{ plan.id }}" data-plan-name="{{ plan.name }}">{{ site.pricing.cta }} <span aria-hidden="true">→</span></button>
      </div>
      <div class="cd-plan-points">
        <span class="cd-plan-label">{{ site.pricing.includesLabel }}</span>
        {%- for pt in plan.points %}
        <div class="cd-check">{{ ui.check() }}<span>{{ pt }}</span></div>
        {%- endfor %}
      </div>
    </article>
    {%- endfor %}
    {%- if site.pricing.assurances %}
    <ul class="cd-frame-foot">
      {%- for a in site.pricing.assurances %}
      <li>{{ ui.check() }}<span>{{ a }}</span></li>
      {%- endfor %}
    </ul>
    {%- endif %}
  </div>
</section>

<!-- ============ 04 NUTRITION ============ -->
<section id="nutrition" class="cd-section cd-section--flush cd-reveal">
  {{ ui.rail("04", site.nutrition.eyebrow, site.nutrition.rail) }}
  <div class="cd-head-row">
    <div class="cd-head-row-text">
      <h2 class="cd-h2">{{ site.nutrition.heading }}</h2>
      <p class="cd-body">{{ site.nutrition.desc }}</p>
    </div>
    <a id="recipes" href="{{ site.nutrition.cta.href }}" class="cd-btn cd-btn--ghost">{{ site.nutrition.cta.label }}</a>
  </div>

  <div class="cd-dishes cd-frame">
    {%- for r in recipes | limit(3) %}
    <a href="/blog/{{ r.slug }}/" class="cd-dish">
      {{ ui.strip(r.categoryName, "0" ~ loop.index) }}
      <span class="cd-dish-media">
        <img src="{{ r.image }}" alt="" loading="lazy">
        {%- if r.minutes %}<span class="cd-pill">{{ r.minutes }} хв</span>{% endif %}
      </span>
      <span class="cd-cell cd-dish-body">
        <span class="cd-dish-row">
          <span class="cd-dish-title">{{ r.name }}</span>
          <span class="cd-arrow" aria-hidden="true">→</span>
        </span>
        <span class="cd-chips">
          <span class="cd-chip">{{ r.calories }} ккал</span>
          <span class="cd-chip">{{ r.protein }}г білка</span>
          <span class="cd-chip">{{ r.carbs }}г вугл.</span>
          <span class="cd-chip">{{ r.fats }}г жирів</span>
        </span>
      </span>
    </a>
    {%- endfor %}
  </div>
</section>

<!-- ============ 05 REVIEWS ============ -->
<section id="reviews" class="cd-section cd-section--flush cd-reveal">
  {{ ui.rail("05", site.reviews.eyebrow, site.reviews.rail) }}
  <h2 class="cd-h2">{{ site.reviews.heading }}</h2>
  {#- Stars in the strip, the number of the review on the right; the featured
      quote is 01 and takes the wide cell beside the photo. #}
  {%- set starsHtml = '<span class="cd-stars" aria-label="5 з 5">★★★★★</span>' %}
  <div class="cd-reviews cd-frame">
    <div class="cd-review-photo">
      <img src="{{ site.reviews.featured.image }}"
           srcset="{{ site.reviews.featured.image }} 1x, {{ site.reviews.featured.image | retina }} 2x"
           alt="" loading="lazy">
    </div>
    <blockquote class="cd-review is-featured">
      {{ ui.strip("", "01", starsHtml) }}
      <div class="cd-cell cd-review-body">
        <div class="cd-review-quote-text">
          <span class="cd-quote-mark" aria-hidden="true">“</span>
          <p>{{ site.reviews.featured.text }}</p>
        </div>
        <footer class="cd-review-author cd-review-author--lg">
          <img src="{{ site.reviews.featured.avatar }}"
               srcset="{{ site.reviews.featured.avatar }} 1x, {{ site.reviews.featured.avatar | retina }} 2x"
               alt="" width="56" height="56" loading="lazy">
          <b>{{ site.reviews.featured.author }}</b>
        </footer>
      </div>
    </blockquote>
    {%- for r in site.reviews.items %}
    <blockquote class="cd-review">
      {{ ui.strip("", "0" ~ (loop.index + 1), starsHtml) }}
      <div class="cd-cell cd-review-body">
        <p>{{ r.text }}</p>
        <footer class="cd-review-author">
          <img src="{{ r.avatar }}"
               srcset="{{ r.avatar }} 1x, {{ r.avatar | retina }} 2x"
               alt="" width="48" height="48" loading="lazy">
          <b>{{ r.author }}</b>
        </footer>
      </div>
    </blockquote>
    {%- endfor %}
  </div>
</section>

<!-- ============ 06 FAQ ============ -->
<section id="faq" class="cd-section cd-section--flush cd-reveal">
  {{ ui.rail("06", site.faq.eyebrow, site.faq.rail) }}
  <div class="cd-faq">
    <div class="cd-faq-aside">
      <h2 class="cd-h2">{{ site.faq.heading }}</h2>
      <button type="button" class="cd-btn cd-btn--orange" data-modal-open>{{ site.faq.cta }}</button>
    </div>
    <div class="cd-faq-list" data-faq>
      {{ ui.strip(site.faq.rail, site.faq.items | length) }}
      {%- for item in site.faq.items %}
      <details class="cd-faq-item{% if loop.index > site.faq.initialCount %} is-extra{% endif %}"{% if item.open %} open{% endif %}>
        <summary class="cd-faq-q">
          <span>{{ item.q }}</span>
          <span class="cd-faq-icon" aria-hidden="true">+</span>
        </summary>
        {#- Wrapper exists purely so its height can be animated; <details> itself
            jumps straight to auto and cannot be transitioned. #}
        <div class="cd-faq-body">
          <div class="cd-faq-content">
            {%- if item.a %}<p>{{ item.a }}</p>{% endif %}
            {%- if item.list %}
            <ul>
              {%- for li in item.list %}
              <li>{{ li }}</li>
              {%- endfor %}
            </ul>
            {%- endif %}
            {%- if item.note %}<p>{{ item.note }}</p>{% endif %}
          </div>
        </div>
      </details>
      {%- endfor %}
      {%- if site.faq.items | length > site.faq.initialCount %}
      <button type="button" class="cd-faq-more" data-faq-more aria-expanded="false"
              data-more-label="{{ site.faq.showAll }} ({{ site.faq.items | length }}) ↓"
              data-less-label="{{ site.faq.showLess }}">{{ site.faq.showAll }} ({{ site.faq.items | length }}) ↓</button>
      {%- endif %}
    </div>
  </div>
</section>

<!-- ============ 07 CTA ============ -->
<section class="cd-section cd-section--flush cd-reveal">
  <div class="cd-banner cd-banner--contact">
    <img class="cd-banner-bg" src="/assets/banner-space-bg.webp" alt="" loading="lazy">
    <img class="cd-banner-decor cd-banner-cloud-1" src="/assets/banner-cloud-1.svg" alt="" loading="lazy">
    <img class="cd-banner-decor cd-banner-cloud-2" src="/assets/banner-cloud-2.svg" alt="" loading="lazy">
    <div class="cd-banner-decor cd-astronaut" aria-hidden="true">
      {% include "partials/astronaut.njk" %}
    </div>

    <div class="cd-banner-content">
      <span class="cd-eyebrow">07 / {{ site.banner.eyebrow }}</span>
      <h2 class="cd-banner-head">{{ site.banner.heading }}</h2>
      <p class="cd-banner-sub">{{ site.banner.sub }}</p>
      <button type="button" class="cd-btn cd-btn--light" data-modal-open>{{ site.banner.cta }}</button>
    </div>
  </div>
</section>

{% include "partials/footer.njk" %}
