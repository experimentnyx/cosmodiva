---
layout: layouts/base.njk
permalink: /blog/index.html
title: Рецепти — Anastasiia
description: Колекція корисних і смачних рецептів від Анастасії Шерстюк.
---
{% import "partials/macros.njk" as ui %}
{% set featured = recipes | first %}
{% set categories = recipes | categories %}

<!-- ============ INTRO ============ -->
<section class="cd-page-intro cd-reveal">
  <p class="cd-crumbs">
    <a href="/">{{ site.blog.breadcrumbHome }}</a><span class="cd-crumbs-sep">/</span><span class="cd-accent">{{ site.blog.breadcrumb }}</span>
  </p>
  <h1 class="cd-blog-title">{{ site.blog.title }}</h1>
  <div class="cd-split">
    <p class="cd-blog-sub">{{ site.blog.subtitle }} <span class="cd-accent">{{ site.blog.subtitleAccent }}</span></p>
    <p class="cd-body">{{ site.blog.desc }}</p>
  </div>
</section>

{%- if featured %}
<!-- ============ 01 FEATURED ============ -->
<section class="cd-section cd-section--flush cd-section--tight cd-reveal">
  {%- set featKcal = (featured.calories ~ " ккал") if featured.calories else "" %}
  {%- set featRight = featured.categoryName ~ (" · " if (featured.categoryName and featKcal) else "") ~ featKcal %}
  {{ ui.rail("01", site.blog.featuredRail, featRight) }}
  {#- Framed like the rest of the site: photo cell + highlighted info cell with
      the orange strip. Clickable as a whole, like the grid cells. #}
  <a href="/blog/{{ featured.slug }}/" class="cd-featured cd-frame">
    <span class="cd-featured-photo">
      <img src="{{ featured.image }}" alt="" loading="lazy">
      {%- if featured.minutes %}<span class="cd-pill">{{ featured.minutes }} хв</span>{% endif %}
    </span>
    <span class="cd-featured-info is-featured">
      <span class="cd-strip">
        <span class="cd-strip-label"><span aria-hidden="true">★ </span>{{ site.blog.featuredRail }}</span>
        <span class="cd-strip-num">{{ featured.categoryName }}</span>
      </span>
      <span class="cd-featured-text">
        <span class="cd-featured-title">{{ featured.name }}</span>
        {%- if featured.description %}<span class="cd-body">{{ featured.description }}</span>{% endif %}
        <span class="cd-chips">
          {%- if featured.calories %}<span class="cd-chip">{{ featured.calories }} ккал</span>{% endif %}
          {%- if featured.protein %}<span class="cd-chip">{{ featured.protein }}г білка</span>{% endif %}
          {%- if featured.carbs %}<span class="cd-chip">{{ featured.carbs }}г вугл.</span>{% endif %}
          {%- if featured.fats %}<span class="cd-chip">{{ featured.fats }}г жирів</span>{% endif %}
        </span>
        {#- A <span>, not a nested link: the card itself is the link. #}
        <span class="cd-btn cd-btn--orange">{{ site.blog.cardCta }} <span aria-hidden="true">→</span></span>
      </span>
    </span>
  </a>
</section>
{%- endif %}

<!-- ============ 02 ALL RECIPES ============ -->
<section id="blog-content" class="cd-section cd-section--flush cd-section--tight cd-reveal">
  {{ ui.rail("02", site.blog.allRail, ui.recipeCount(recipes | length)) }}
  <div class="cd-head-row">
    <h2 class="cd-h2">{{ site.blog.allHeading }}</h2>
    {#- A filter with a single option would be theatre, so it only appears once
        the collection genuinely spans 2+ categories. #}
    {%- if categories | length > 1 %}
    <div class="cd-filters" role="group" aria-label="Фільтр за категорією">
      <button type="button" class="cd-filter is-active" data-filter="all" aria-pressed="true">{{ site.blog.allFilter }}</button>
      {%- for c in categories %}
      <button type="button" class="cd-filter" data-filter="{{ c.slug }}" aria-pressed="false">{{ c.name }}</button>
      {%- endfor %}
    </div>
    {%- endif %}
  </div>

  {#- Open frame: drawn with cell borders rather than the gap trick, so a
      filtered category that leaves a row half full shows empty space, not a
      grey block. #}
  <div class="cd-dishes cd-dishes--grid cd-frame cd-frame--open" data-recipe-grid>
    {%- for r in recipes %}
    {{ ui.dish(r, ("0" if loop.index < 10) ~ loop.index) }}
    {%- endfor %}
  </div>
</section>

<!-- ============ CTA ============ -->
<section class="cd-section cd-section--flush cd-reveal">
  <div class="cd-banner cd-banner--row">
    <img class="cd-banner-bg" src="/assets/banner-space-bg.webp" alt="" loading="lazy">
    <div class="cd-banner-content">
      <span class="cd-eyebrow">{{ site.blog.banner.eyebrow }}</span>
      <h2 class="cd-banner-head cd-banner-head--sm">{{ site.blog.banner.heading }}</h2>
    </div>
    <a href="{{ site.blog.banner.cta.href }}" class="cd-btn cd-btn--light">{{ site.blog.banner.cta.label }}</a>
  </div>
</section>

{% include "partials/footer.njk" %}
