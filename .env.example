# Copy the values into Vercel → Project → Settings → Environment Variables.
# Nothing here belongs in the repo; this file only documents the names.

# --- Monobank "plata by mono" acquiring ---
# Token from web.monobank.ua → Оплата на сайті → Створити токен
# Use the TEST token from https://api.monobank.ua while testing.
MONO_TOKEN=

# --- Resend (transactional email) ---
RESEND_API_KEY=
# Verified sender, e.g. "Anastasiia <hello@yourdomain>". Falls back to Resend's
# onboarding@resend.dev for testing.
MAIL_FROM=
# Where sale notifications go (the owner's inbox).
OWNER_EMAIL=

# --- Upstash Redis / Vercel KV (order store + idempotency) ---
# Created in one click from the Vercel dashboard; these two are injected
# automatically when you link a KV/Upstash store to the project.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# --- Deliverables emailed to the buyer per plan ---
# Put the real access content here (URLs and/or text). Line breaks and links are
# rendered in the email. These map to the plan ids in api/_lib/catalog.js.
DELIVER_BODYWEIGHT_MFR=
DELIVER_INDIVIDUAL=
DELIVER_MEAL_PLAN=
DELIVER_TELEGRAM=
